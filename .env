# SPOFE v2.1 - Environment Variables - DEVELOPMENT
NODE_ENV=development
PORT=3001

# Database Configuration - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DEV_DB_PASSWORD
DB_DATABASE=spofe_v2_1
DB_SSL=false

# Redis Configuration
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT Configuration
JWT_SECRET=CHANGE_ME_DEV_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_DEV_JWT_REFRESH_SECRET
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting Configuration
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_MS=900

# Development Mode
DEVELOPMENT_MODE=true
DEBUG=true
