# SPOFE Production Environment Variables
# Copy this file to .env.production and set real values.

# Application
NODE_ENV=production
LOG_LEVEL=info
PORT=3001
HOST=0.0.0.0

# PostgreSQL
DB_HOST=prod-postgres
DB_PORT=5432
DB_NAME=spofe
DB_DATABASE=spofe
DB_USER=spofe_user
DB_PASSWORD=CHANGE_ME_PROD_DB_PASSWORD
DATABASE_URL=postgresql://spofe_user:CHANGE_ME_PROD_DB_PASSWORD@prod-postgres:5432/spofe
DB_SSL=true

# Guardian
GUARDIAN_VERSION=4
GUARDIAN_MODE=strict
GUARDIAN_CACHE_TTL=3600

# API behavior
REQUEST_TIMEOUT=30000
CORS_ORIGIN=https://spofe.example.com

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=true
TRACE_SAMPLE_RATE=1.0

# Feature flags
FEATURE_AUDIT_LOGGING=true
FEATURE_COMPRESSION=true
FEATURE_CACHING=true

# Security
JWT_SECRET=CHANGE_ME_PROD_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_PROD_JWT_REFRESH_SECRET
SESSION_SECRET=CHANGE_ME_PROD_SESSION_SECRET
