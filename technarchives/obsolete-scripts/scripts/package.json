{
  "name": "spofe-auto-fix",
  "version": "1.0.0",
  "description": "Automatisation du diagnostic et de la correction du système SPOFE v2.1",
  "main": "auto-fix.js",
  "type": "module",
  "scripts": {
    "start": "node auto-fix.js",
    "dry-run": "node auto-fix.js --dry-run",
    "skip-package": "node auto-fix.js --skip-package",
    "skip-db": "node auto-fix.js --skip-db",
    "skip-report": "node auto-fix.js --skip-report",
    "verbose": "node auto-fix.js --verbose",
    "all": "npm run start && npm run report"
  },
  "keywords": [
    "spofe",
    "automation",
    "diagnostics",
    "fixing",
    "testing"
  ],
  "author": "SPOFE Team",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "dotenv": "^16.0.3",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
