{
  "name": "@spofe/module-parametres",
  "version": "1.0.0",
  "description": "Module Paramètres - Socle normatif constitutionnel SPOFE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.module.json",
    "build:watch": "tsc -p tsconfig.module.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rimraf dist"
  },
  "keywords": [
    "spofe",
    "parametres",
    "configuration",
    "constitutional",
    "normative"
  ],
  "author": "SPOFE Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.5",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.49.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "spofe": {
    "module": {
      "name": "parametres",
      "version": "1.0.0",
      "governance": "SPOFE P0 - Constitutional",
      "type": "READ_ONLY_PROVIDER",
      "status": "READY_FOR_CERTIFICATION"
    },
    "buildProof": {
      "enabled": true,
      "checks": [
        "dependencies",
        "scope",
        "guardian",
        "no_write_outside_guardian",
        "system_tests"
      ]
    }
  }
}
