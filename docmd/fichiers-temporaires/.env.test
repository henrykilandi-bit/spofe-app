# SPOFE PostgreSQL CI - Configuration canonique
# Date: 2 février 2026

# PostgreSQL Connection (SPOFE Standard)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=spofe_test

# Legacy compatibility (en cours de migration)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=spofe_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# Test Environment
NODE_ENV=test
LOG_LEVEL=warn

# STANDARD SPOFE NON NÉGOCIABLE
# - Pas de variables magiques
# - Pas de secrets CI divergents  
# - Même config pour tous les modules
