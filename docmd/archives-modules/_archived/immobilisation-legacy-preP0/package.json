{
  "name": "@spofe/immobilisation",
  "version": "1.0.0",
  "description": "SPOFE Platform — Immobilisation (Fixed Assets) Module",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.guardian-only.js",
    "test:module": "jest --config jest.config.guardian-only.js",
    "test:unit": "jest --testPathPatterns=unit",
    "test:unit:guardian": "jest tests/unit/guardian.unit.spec.ts",
    "test:integration": "jest --testPathPatterns=integration",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:e2e:coverage": "jest --config jest.e2e.config.js --coverage",
    "test:contract": "jest --config tests/contract/jest.contract.config.js",
    "test:contract:ci": "jest --config tests/contract/jest.contract.config.js --ci --coverage",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:from-nestjs": "tsx scripts/generate-openapi-from-nestjs.ts",
    "openapi:check": "tsx scripts/generate-openapi-from-nestjs.ts --check",
    "openapi:validate": "tsx scripts/generate-openapi.ts"
  },
  "keywords": [
    "spofe",
    "immobilisation",
    "fixed-assets",
    "depreciation",
    "cqrs",
    "ddd"
  ],
  "author": "SPOFE Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.0",
    "fastify": "^5.7.2",
    "jest": "^29.0.0",
    "rimraf": "^5.0.0",
    "supertest": "^6.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@nestjs/core": "^10.0.0",
    "pg": "^8.0.0"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./api": {
      "import": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./domain": {
      "import": "./dist/domain/index.js",
      "types": "./dist/domain/index.d.ts"
    },
    "./openapi": {
      "import": "./openapi/immobilisation.openapi.json"
    }
  }
}
