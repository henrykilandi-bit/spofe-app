  "paths": {
    "/cost-structure/budget-ready/projects": {
      "get": {
        "operationId": "BudgetReady_listBudgetReadyProjects",
        "tags": [
          "Cost-Structure — Budget Contract"
        ],
        "summary": "List budget-ready projects",
        "description": "Returns all APPROVED projects ready for Budget consumption (COUT-BUD-01)",
        "parameters": [
          {
            "name": "x-tenant-id",
            "in": "header",
            "required": true,
            "description": "Tenant ID for multi-tenant isolation",
            "schema": {
              "type": "string",
              "example": "tenant-1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of budget-ready projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BudgetReadyProjectDTO"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid tenant ID"
          }
        }
      }
    },
    "/cost-structure/budget-ready/projects/{projectId}": {
      "get": {
        "operationId": "BudgetReady_getBudgetReadyProject",
        "tags": [
          "Cost-Structure — Budget Contract"
        ],
        "summary": "Get budget-ready project by ID",
        "description": "Returns a specific APPROVED project for Budget consumption",
        "parameters": [
          {
            "name": "x-tenant-id",
            "in": "header",
            "required": true,
            "description": "Tenant ID for multi-tenant isolation",
            "schema": {
              "type": "string",
              "example": "tenant-1"
            }
          },
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "Project identifier",
            "schema": {
              "type": "string",
              "example": "project-123"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Budget-ready project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetReadyProjectDTO"
                }
              }
            }
          },
          "404": {
            "description": "Project not found or not budget-ready"
          }
        }
      }
    },
