    {
      "url": "/api",
      "description": "SPOFE API Gateway"
    }
  ],
  "tags": [
    {
      "name": "Cost-Structure — Budget Contract",
      "description": "Endpoints for Budget module consumption (COUT-BUD-01)"
    },
