{
  "name": "spofe-app",
  "version": "2.2.0",
  "description": "SPOFE - Système de Pilotage Opérationnel et Financier Étendu - Application de comptabilité OHADA conforme WAEMU",
  "private": true,
  "license": "PROPRIETARY",
  "author": "Équipe SPOFE <tech@spofe.sn>",
  "homepage": "https://spofe.sn",
  "repository": {
    "type": "git",
    "url": "https://github.com/votre-organisation/spofe-app.git"
  },
  "keywords": [
    "comptabilité",
    "ohada",
    "waemu",
    "sénégal",
    "afrique",
    "gestion",
    "finance",
    "multi-entreprises"
  ],
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  },
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd cascade && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "npm run dev",
    "start:prod": "cd cascade && npm run start",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd cascade && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "docker:build": "docker-compose -f docker-compose.prod.yml build",
    "docker:up": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "docker:restart": "npm run docker:down && npm run docker:build && npm run docker:up",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "cd cascade && npm run test:unit",
    "test:integration": "cd cascade && npm run test:integration",
    "test:coverage": "cd cascade && npm run test:coverage",
    "diagnose": "npm run diagnose:db && npm run diagnose:security",
    "diagnose:db": "node scripts/database-comprehensive-test.js",
    "diagnose:security": "node scripts/security-audit-check.js",
    "db:setup": "cd cascade && npm run db:setup",
    "setup:db": "node cascade/scripts/setup-database.mjs",
    "setup:db:validate": "node cascade/scripts/setup-database.mjs --validate-only",
    "db:migrate": "cd cascade && npx sequelize db:migrate",
    "db:migrate:undo": "cd cascade && npx sequelize db:migrate:undo",
    "db:seed": "cd cascade && npx sequelize db:seed:all",
    "db:seed:undo": "cd cascade && npx sequelize db:seed:undo:all",
    "db:reset": "npm run db:migrate:undo && npm run db:migrate && npm run db:seed",
    "monitor": "node scripts/integrated-monitoring-system.js",
    "audit": "npm audit --production",
    "audit:fix": "npm audit fix --production",
    "🔧 CONVENTIONS SPOFE v2.2": "",
    "conventions:check": "node scripts/conventions-compliance-checker.js",
    "conventions:fix": "node scripts/conventions-compliance-checker.js --fix",
    "conventions:report": "node scripts/conventions-compliance-checker.js --report",
    "conventions:watch": "node scripts/conventions-compliance-checker.js --watch",
    "conventions:precommit": "node scripts/pre-commit-hook.js",
    "conventions:install": "node scripts/install-pre-commit.js",
    "🔐 SILC INTER-LAYER CONTRACT v1.0": "",
    "validate:silc": "node cascade/scripts/validate-contract.mjs",
    "validate:silc:report": "node cascade/scripts/validate-contract.mjs && cat cascade/contract/reports/silc-validation.json",
    "lint:contract": "node cascade/scripts/lint-contract.mjs",
    "lint:contract:report": "node cascade/scripts/lint-contract.mjs && cat cascade/contract/reports/silc-linter-report.json",
    "contract:check": "npm run validate:silc && npm run lint:contract",
    "validate:db": "node cascade/scripts/validate-database.mjs",
    "validate:db:report": "node cascade/scripts/validate-database.mjs && cat cascade/contract/reports/database-validation.json",
    "audit:db": "node cascade/scripts/validate-database.mjs",
    "audit:contract": "npm run contract:check && npm run validate:db",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd cascade && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:fix": "npm run lint:backend --fix && npm run lint:frontend --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "clean": "rm -rf node_modules cascade/node_modules frontend/node_modules",
    "reinstall": "npm run clean && npm install",
    "update": "npm update",
    "health": "curl http://localhost:3001/api/health || echo \"Server not responding\"",
    "setup": "npm install && cd cascade && npm install && cd ../frontend && npm install",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "test:e2e:chromium": "npx playwright test --project=chromium",
    "test:e2e:firefox": "npx playwright test --project=firefox",
    "test:e2e:webkit": "npx playwright test --project=webkit",
    "test:e2e:performance": "npx playwright test --project=performance",
    "test:e2e:smoke": "npx playwright test --project=smoke",
    "test:e2e:business-flows": "npx playwright test e2e/business-flows.spec.js",
    "test:perf:report": "npx playwright test --project=performance && node scripts/parse-performance.js",
    "test:e2e:report": "node scripts/generate-test-summary.js",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-slow-down": "^1.5.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "i18n": "^0.15.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.0",
    "nodemailer": "^6.9.7",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.14.0",
    "prom-client": "^14.2.0",
    "rate-limit-redis": "^3.0.1",
    "redis": "^4.6.0",
    "sequelize": "^6.35.0",
    "socket.io": "^4.7.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@playwright/test": "^1.57.0",
    "commitlint": "^18.4.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^1.7.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.2",
    "npm-check-updates": "^16.14.0",
    "nyc": "^15.1.0",
    "prettier": "^3.1.0",
    "sinon": "^17.0.1",
    "supertest": "^6.3.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "vitest": "^4.0.17",
    "webpack": "^5.89.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
