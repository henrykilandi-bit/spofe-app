# SPOFE v2.1 - Environment Variables
# Copy this file to .env and fill in your values

# ========================================
# NODE ENVIRONMENT
# ========================================
NODE_ENV=production
LOG_LEVEL=info
DEBUG=false

# ========================================
# SERVER CONFIGURATION
# ========================================
# Main server port (when not using load balancer)
PORT=3000
# Or for load-balanced setup:
# PORT=3001  # Instance 1
# PORT=3002  # Instance 2
# PORT=3003  # Instance 3
# PORT=3004  # Instance 4

# Server hostname
SERVER_HOST=localhost

# ========================================
# AUTHENTICATION & SECURITY
# ========================================
# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production

# JWT Expiration
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# CSRF Secret
CSRF_SECRET=your-super-secret-csrf-key-here-change-in-production

# Session Secret (for express-session)
SESSION_SECRET=your-super-secret-session-key-here-change-in-production

# ========================================
# DATABASE CONFIGURATION
# ========================================
# MySQL Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=spofe_user
DB_PASSWORD=spofe_user_secure_password
DB_DATABASE=spofe_db

# MySQL Root (for initialization only)
MYSQL_ROOT_PASSWORD=spofe_root_secure_password

# Connection Pool
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ========================================
# REDIS CONFIGURATION
# ========================================
# Redis Connection (for cache and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_DATABASE=0
REDIS_SSL=false

# Redis Cluster (if using Redis Cluster)
# REDIS_CLUSTER_NODES=node1:6379,node2:6379,node3:6379

# Redis Connection Pool
REDIS_POOL_MIN=5
REDIS_POOL_MAX=20

# ========================================
# CACHE CONFIGURATION
# ========================================
# Cache Strategy: "redis" | "memory" | "hybrid"
CACHE_STRATEGY=redis

# Cache TTL (in seconds)
CACHE_TTL_SHORT=300         # 5 minutes
CACHE_TTL_MEDIUM=3600       # 1 hour
CACHE_TTL_LONG=86400        # 24 hours
CACHE_TTL_CHART=604800      # 7 days

# In-Memory Cache Size (when not using Redis)
MEMORY_CACHE_MAX_SIZE=500

# ========================================
# SESSION CONFIGURATION
# ========================================
# Session Store: "redis" | "memory"
SESSION_STORE=redis

# Session Expiration (in milliseconds)
SESSION_EXPIRATION=86400000  # 24 hours

# ========================================
# LOAD BALANCING
# ========================================
# Instance ID (for multi-instance setup)
INSTANCE_ID=1

# Load Balancer Mode
LOAD_BALANCER_ENABLED=true

# Health Check Endpoint
HEALTH_CHECK_ENABLED=true

# ========================================
# RATE LIMITING
# ========================================
# Rate Limit: requests per minute
RATE_LIMIT_GENERAL=6000     # 100 req/s
RATE_LIMIT_AUTH=600         # 10 req/s
RATE_LIMIT_API=1200         # 20 req/s

# ========================================
# LOGGING
# ========================================
# Log Directory
LOG_DIR=./logs

# Log Level: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# Console Logging
LOG_CONSOLE=true

# File Logging
LOG_FILE=true
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=14

# ========================================
# EMAIL CONFIGURATION (Optional)
# ========================================
# SMTP Server
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@spofe.app
EMAIL_FROM_NAME=SPOFE

# Email Service Provider (sendgrid | mailgun | nodemailer)
EMAIL_PROVIDER=nodemailer

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================
# Upload Directory
UPLOAD_DIR=./uploads

# Max File Size (in MB)
MAX_FILE_SIZE=50

# Allowed MIME Types
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/csv,application/vnd.ms-excel

# ========================================
# CORS CONFIGURATION
# ========================================
# CORS Origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:8080

# CORS Methods
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# CORS Credentials
CORS_CREDENTIALS=true

# ========================================
# EXTERNAL API INTEGRATIONS
# ========================================
# Bank API Integration (if applicable)
BANK_API_KEY=your-bank-api-key
BANK_API_SECRET=your-bank-api-secret
BANK_API_ENDPOINT=https://api.bank.example.com

# Tax Authority API (if applicable)
TAX_API_KEY=your-tax-api-key
TAX_API_ENDPOINT=https://api.tax.example.com

# ========================================
# REPORTING & EXPORT
# ========================================
# Report Export Formats
EXPORT_FORMATS=pdf,excel,csv

# Report Template Directory
REPORT_TEMPLATE_DIR=./templates/reports

# ========================================
# AUDIT & COMPLIANCE
# ========================================
# Audit Logging
AUDIT_ENABLED=true
AUDIT_LOG_DIR=./logs/audit

# Data Retention (in days)
DATA_RETENTION_DAYS=2555  # ~7 years for financial records

# ========================================
# MONITORING & OBSERVABILITY
# ========================================
# Prometheus Metrics
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Application Performance Monitoring
APM_ENABLED=false
APM_SERVICE_NAME=spofe-api
APM_SERVER_URL=http://localhost:8200

# Health Check
HEALTH_CHECK_INTERVAL=10000  # 10 seconds

# ========================================
# FEATURE FLAGS
# ========================================
# Feature Flags (enable/disable features)
FEATURE_ADVANCED_CACHE=true
FEATURE_LOAD_BALANCING=true
FEATURE_RATE_LIMITING=true
FEATURE_AUDIT_LOGGING=true

# ========================================
# DEVELOPMENT & DEBUGGING
# ========================================
# Development Mode (enables extra logging, bypasses some checks)
DEVELOPMENT_MODE=false

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_PATH=/api-docs

# Mock Data
USE_MOCK_DATA=false

# ========================================
# DATABASE SEEDING (Development)
# ========================================
# Auto-seed database on startup
SEED_DATABASE=false

# Seed Data File
SEED_DATA_FILE=./seeds/data.sql

