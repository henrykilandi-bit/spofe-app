{
  "name": "spofe-frontend",
  "version": "1.0.0",
  "description": "SPOFE Accounting - React Frontend with Vite",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "e2e": "cypress open",
    "e2e:headless": "cypress run",
    "lint": "eslint src --ext js,jsx",
    "lint:fix": "eslint src --ext js,jsx --fix",
    "check:conventions": "node src/scripts/conventions/conventions-checker.js",
    "spofe:audit": "node src/scripts/conventions/conventions-audit.js",
    "spofe:auto-fix": "npm run check:conventions && npm run spofe:audit",
    "spofe:lock": "node src/scripts/conventions/conventions-lock.js",
    "spofe:lock:status": "node src/scripts/conventions/conventions-lock.js status",
    "spofe:lock:production": "node src/scripts/conventions/conventions-lock.js production",
    "spofe:precommit": "node src/scripts/conventions/conventions-lock.js precommit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@tanstack/react-query": "^5.90.19",
    "antd": "^6.2.1",
    "autoprefixer": "^10.4.0",
    "axios": "^1.13.2",
    "lucide-react": "^0.563.0",
    "postcss": "^8.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.15.4",
    "tailwindcss": "^3.3.0",
    "zod": "^4.3.5",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "cypress": "^13.17.0",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.1.0",
    "terser": "^5.46.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  }
}
