{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./dist-aga",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["aga/**/*"],
  "exclude": ["node_modules", "dist-aga", "domain/**/*"]
}
