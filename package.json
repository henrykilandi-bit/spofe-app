{
  "name": "spofe-app",
  "version": "2.1.0",
  "type": "module",
  "private": true,
  "description": "SPOFE v2.1 - Gouverne par SILC v2",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:system": "jest --config jest.system.config.js",
    "check:root": "npm test -- --runInBand",
    "check:e2e": "npm run test:e2e -- --runInBand",
    "check:system": "npm run test:system",
    "check:modules": "npm run test:modules",
    "check:modules:extended": "npm run test:modules:extended",
    "repo:health": "npm test -- --runInBand && npm run test:e2e -- --runInBand && npm run test:system && npm run test:modules",
    "check:repo": "node tools/operations/check-repo-tracked.mjs",
    "server:run": "node --import tsx tools/runtime/server-runner.mjs",
    "server:start": "node tools/runtime/server-start-detached.mjs",
    "server:stop": "node tools/runtime/server-stop.mjs",
    "server:health": "node tools/runtime/server-health-smoke.mjs",
    "server:env:check": "node tools/runtime/check-runtime-env.mjs",
    "server:smoke": "node --import tsx tools/runtime/server-smoke-inline.mjs",
    "pilot:supervision": "node tools/runtime/pilot-supervision-cycle.mjs",
    "db:check": "node tools/operations/db-check.mjs",
    "db:ensure": "node tools/operations/db-ensure-database.mjs",
    "db:migrate": "node tools/operations/db-migrate.mjs",
    "db:backup": "node tools/operations/db-backup.mjs",
    "db:restore": "node tools/operations/db-restore.mjs",
    "db:backup:smoke": "node tools/operations/db-backup-restore-smoke.mjs",
    "release:gate": "npm run check:repo && npm run server:smoke && npm run db:check",
    "kpi:exploitation": "node tools/operations/kpi-exploitation-report.mjs",
    "ci:exploitation:precheck": "node tools/operations/ci-exploitation-gh.mjs precheck",
    "ci:exploitation:dispatch": "node tools/operations/ci-exploitation-gh.mjs dispatch",
    "change:governance:check": "node tools/operations/change-governance-check.mjs",
    "test:modules": "npm run test:module:gestion-stocks && npm run test:module:immobilisation && npm run test:module:comptabilite && npm run test:module:gestion-commandes && npm run test:module:objectif-indicateurs-evenements && npm run test:module:tresorerie-banque",
    "test:modules:extended": "npm run test:modules && npm run test:module:tresorerie-caisse && npm run test:module:budget && npm run test:module:amortissement",
    "test:module:gestion-stocks": "cd cascade/modules/gestion-stocks && npm test -- --runInBand",
    "test:module:immobilisation": "cd cascade/modules/immobilisation && npm test -- --runInBand",
    "test:module:comptabilite": "cd cascade/modules/comptabilite && npm test",
    "test:module:gestion-commandes": "cd cascade/modules/gestion-commandes && npm test",
    "test:module:objectif-indicateurs-evenements": "cd cascade/modules/objectif-indicateurs-evenements && npm test",
    "test:module:tresorerie-banque": "cd cascade/modules/tresorerie-banque && npm test -- --runInBand",
    "test:module:tresorerie-caisse": "cd cascade/modules/tresorerie-caisse && npm test",
    "test:module:budget": "cd cascade/modules/budget && npm test -- --runInBand",
    "test:module:amortissement": "cd cascade/modules/amortissement && npm test -- --runInBand",
    "build-proof": "npx tsx tools/build-proof/generate-build-proof.ts",
    "build-proof:module": "npx tsx tools/build-proof/generate-build-proof.ts",
    "build:proof": "npm run build-proof",
    "build:proof:module": "npm run build-proof:module",
    "validate": "npm run build-proof",
    "new-module": "node tools/spofe-new-module.js",
    "test:new-module": "node tools/test-spofe-new-module.js",
    "validate:modules": "node tools/validate-modules-structure.js",
    "update-governance": "echo '⚠️  update-governance désactivé - script archivé dans obsolete/'",
    "update-governance-dry": "echo '⚠️  update-governance-dry désactivé - script archivé dans obsolete/'",
    "build-proof-official": "npx tsx tools/build-proof/generate-build-proof.ts --module immobilisation",
    "sign-build-proof": "npx tsx tools/build-proof/sign-build-proof.ts",
    "validate-module": "npx tsx tools/validate-module/spofe-validate-module.ts",
    "test:contracts": "cd cascade && jest --config=jest.config.contracts.cjs",
    "aga:check": "tsx aga/cli.ts src",
    "aga:report": "tsx aga/cli.ts src > .aga/reports/latest.json",
    "aga:ci": "npm run aga:check && echo '✅ Architecture conforme'",
    "validate:no-write": "tsx tools/contracts-check/no-write-guardian/index.ts",
    "test:no-write": "vitest tools/contracts-check/no-write-guardian",
    "validate:constitution": "npm run validate:no-write && echo '🛡️  SPOFE Constitution enforced'",
    "pre-build-proof": "npm run validate:constitution",
    "pre-commit": "npm run validate:no-write",
    "build-proof:global": "node tools/build-proof/generate-global-build-proof.mjs",
    "build:proof:global": "npm run build-proof:global",
    "certify:system": "npm run build-proof:global && echo '🏛️ SPOFE System Certified'",
    "validate:fce": "echo '⚠️  validate:fce désactivé - script archivé dans obsolete/'",
    "validate:fce:strict": "echo '⚠️  validate:fce:strict désactivé - script archivé dans obsolete/'",
    "lint:fce": "eslint frontend/core/spofe-contract/",
    "lint:fce:fix": "eslint frontend/core/spofe-contract/ --fix",
    "precommit": "npm run pre-commit",
    "pre-push": "npm run validate:fce:strict && npm run test:contracts",
    "prepush": "npm run pre-push",
    "ci:frontend": "npm run validate:fce:strict && npm run lint:fce && npm run test:contracts",
    "sync:commands": "node scripts/sync-commands-from-openapi.mjs",
    "sync:read-models": "node scripts/sync-read-models-from-openapi.mjs",
    "sync:contracts": "npm run sync:commands && npm run sync:read-models",
    "validate:alignment": "node scripts/validate-openapi-alignment.mjs",
    "alignment:ci": "npm run sync:contracts && npm run validate:alignment && git diff --exit-code contracts/",
    "alignment:check": "npm run validate:alignment",
    "validate:dependencies": "npx tsx tools/dependencies-check/index.ts",
    "test:dependencies": "vitest tools/dependencies-check/dependencies-check.spec.ts",
    "dependencies:help": "npx tsx tools/dependencies-check/index.ts --help",
    "ci:dependencies": "npm run validate:dependencies && npm run test:dependencies",
    "validate:contracts": "npx tsx tools/contracts-check/index.ts",
    "test:contracts:full": "vitest tools/contracts-check/contracts-check.spec.ts",
    "contracts:help": "npx tsx tools/contracts-check/index.ts --help",
    "contracts:report": "npx tsx tools/contracts-check/index.ts --report",
    "ci:contracts": "npm run validate:contracts && npm run test:contracts:full",
    "ci:spofe": "npm run ci:contracts && echo '🚀 SPOFE fully CONTRACT-VERIFIED'",
    "test:build-proof-global": "vitest tools/build-proof-global/build-proof-global.spec.ts",
    "build-proof:system": "npm run ci:contracts && npm run build-proof:global",
    "build:proof:system": "npm run build-proof:system",
    "build-proof:help": "npx tsx tools/build-proof-global/index.ts --help",
    "ci:build-proof": "npm run build-proof:system && npm run test:build-proof-global"
  },
  "author": "Architecture SILC",
  "license": "PROPRIETARY",
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@nestjs/common": "^11.1.12",
    "@nestjs/testing": "^11.1.12",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "jest-util": "^30.2.0",
    "pg": "^8.18.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^5.2.0",
    "@nestjs/core": "^11.1.12",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/swagger": "^11.2.5",
    "@types/uuid": "^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "fastify": "^5.6.1",
    "jose": "^6.1.3",
    "pino-pretty": "^13.1.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "uuid": "^13.0.0",
    "yaml": "^2.8.2"
  }
}
