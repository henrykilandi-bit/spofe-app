        "type": "object",
        "description": "Budget-ready project for Budget module consumption (COUT-BUD-01)",
        "required": [
          "tenantId",
          "projectId",
          "projectName",
          "version",
          "unitCost",
          "totalCost",
          "netMargin",
          "marginAt70"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "description": "Tenant ID (isolation multi-tenant)",
            "example": "tenant-1"
          },
          "projectId": {
            "type": "string",
            "description": "Project unique identifier",
            "example": "project-123"
          },
          "projectName": {
            "type": "string",
            "description": "Project display name",
            "example": "Produit Test"
          },
          "version": {
            "type": "integer",
            "description": "Cost structure version (>= 1)",
            "minimum": 1,
            "example": 2
          },
          "unitCost": {
            "type": "number",
            "description": "Unit cost validated",
            "example": 10
          },
          "totalCost": {
            "type": "number",
            "description": "Total cost validated",
            "example": 10000
          },
          "netMargin": {
            "type": "number",
            "description": "Net margin rate (0-1)",
            "example": 0.25
          },
          "marginAt70": {
            "type": "number",
            "description": "Margin at 70% sales (must be > 0 per COUT-01)",
            "minimum": 0.01,
            "example": 0.08
          }
        }
      },
