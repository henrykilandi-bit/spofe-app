# SPOFE Production Environment Variables
# Copier ce fichier vers .env.production et configurer les valeurs

# ==================== APPLICATION ====================
NODE_ENV=production
LOG_LEVEL=info
PORT=3001

# ==================== DOCKER IMAGES ====================
IMAGE_REGISTRY_OWNER=your-org-or-user
IMAGE_TAG=latest

# ==================== DOMAINS (HTTPS) ====================
FRONTEND_DOMAIN=spofe.example.com
BACKEND_DOMAIN=api.spofe.example.com
LETSENCRYPT_EMAIL=admin@spofe.example.com
FRONTEND_URL=https://spofe.example.com

# ==================== DATABASE ====================
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=spofe_db
MYSQL_USER=spofe_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

DB_HOST=mysql
DB_PORT=3306
DB_NAME=spofe_db
DB_USER=spofe_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ==================== REDIS ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ==================== JWT ====================
# Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_64_BYTES_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_64_BYTES_REFRESH_SECRET
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ==================== FRONTEND ====================
FRONTEND_URL=http://localhost
# En production: https://spofe.votredomaine.com

# ==================== GRAFANA ====================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD

# ==================== SMTP (optionnel) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-app
SMTP_FROM=noreply@spofe.local

# ==================== BACKUP ====================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # 2h du matin tous les jours

# S3 Backup
S3_BUCKET=spofe-backups
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# ==================== MIGRATIONS ====================
MIGRATIONS_AUTO=true

# ==================== MONITORING ====================
# mysql_exporter
MYSQL_EXPORTER_DSN=spofe_user:CHANGE_ME_STRONG_DB_PASSWORD@(mysql:3306)/

# ==================== SÉCURITÉ ====================
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=CHANGE_ME_GENERATE_SESSION_SECRET
SESSION_MAX_AGE=86400000  # 24 heures

# ==================== SECRETS MANAGEMENT ====================
# Option A: AWS Secrets Manager
AWS_SECRETS_MANAGER_ARN=arn:aws:secretsmanager:region:account-id:secret:spofe-prod

# Option B: HashiCorp Vault
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=CHANGE_ME_VAULT_TOKEN
