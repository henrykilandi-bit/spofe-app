# ====================================================================
# SPOFE Configuration Template
# Copy to .env and configure for your environment
# ====================================================================

# ────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ────────────────────────────────────────────────────────────────────

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spofe
DB_USER=spofe_user
DB_PASSWORD=your-secure-password-here

# SSL for production
DB_SSL=false
# DB_SSL=true          # Use for production
# DB_SSL_CERT=/path/to/cert.pem
# DB_SSL_KEY=/path/to/key.pem
# DB_SSL_CA=/path/to/ca.pem

# Connection pool
DB_POOL_MAX=10              # Maximum number of connections
DB_POOL_IDLE_TIMEOUT=30000  # Idle timeout in ms
DB_POOL_CONNECT_TIMEOUT=5000 # Connection timeout in ms

# ────────────────────────────────────────────────────────────────────
# API CONFIGURATION
# ────────────────────────────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development       # development, staging, production
HOST=localhost

# Logging
LOG_LEVEL=info             # debug, info, warn, error
LOG_FORMAT=json            # json, pretty

# ────────────────────────────────────────────────────────────────────
# GUARDIAN CONFIGURATION
# ────────────────────────────────────────────────────────────────────

# Guardian v4 settings
GUARDIAN_VERSION=4
GUARDIAN_MODE=strict       # strict, permissive
GUARDIAN_CACHE_TTL=3600    # Cache TTL in seconds

# ────────────────────────────────────────────────────────────────────
# SECURITY
# ────────────────────────────────────────────────────────────────────

# API Key (optional)
# API_KEY=your-api-key-here

# CORS
CORS_ORIGIN=http://localhost:3000

# Request timeout
REQUEST_TIMEOUT=30000      # in ms

# ────────────────────────────────────────────────────────────────────
# MONITORING
# ────────────────────────────────────────────────────────────────────

# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Request tracing
TRACING_ENABLED=true
TRACE_SAMPLE_RATE=1.0      # 0.0 to 1.0

# ────────────────────────────────────────────────────────────────────
# FEATURES
# ────────────────────────────────────────────────────────────────────

# Feature flags
FEATURE_AUDIT_LOGGING=true
FEATURE_COMPRESSION=true
FEATURE_CACHING=true

# ────────────────────────────────────────────────────────────────────
# DEVELOPMENT ONLY
# ────────────────────────────────────────────────────────────────────

# Mock data
SEED_DATABASE=false
MOCK_GUARDIAN=false

# Hot reload
WATCH_MODE=true
RELOAD_DELAY=1000
