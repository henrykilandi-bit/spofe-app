// Fonction pour obtenir la région selon le pays
const getRegionByCountry = (countryCode) => {
  const regions = {
    'SN': 'Afrique de l\'Ouest (WAEMU)',
    'ML': 'Afrique de l\'Ouest (WAEMU)',
    'CI': 'Afrique de l\'Ouest (WAEMU)',
    'BF': 'Afrique de l\'Ouest (WAEMU)',
    'NE': 'Afrique de l\'Ouest (WAEMU)',
    'TG': 'Afrique de l\'Ouest (WAEMU)',
    'BJ': 'Afrique de l\'Ouest (WAEMU)',
    'GM': 'Afrique de l\'Ouest (WAEMU)',
    'GW': 'Afrique de l\'Ouest (WAEMU)',
    'LR': 'Afrique de l\'Ouest',
    'CD': 'Afrique Centrale (RDC)',
    'CM': 'Afrique Centrale',
    'CG': 'Afrique Centrale',
    'GQ': 'Afrique Centrale',
    'GA': 'Afrique Centrale',
    'TD': 'Afrique Centrale',
    'ZA': 'Afrique Australe',
    'EG': 'Afrique du Nord',
    'MA': 'Afrique du Nord',
    'TN': 'Afrique du Nord',
    'DZ': 'Afrique du Nord',
    'FR': 'Europe de l\'Ouest',
    'BE': 'Europe de l\'Ouest',
    'NL': 'Europe de l\'Ouest',
    'DE': 'Europe de l\'Ouest',
    'GB': 'Europe du Nord',
    'SE': 'Europe du Nord',
    'NO': 'Europe du Nord',
    'DK': 'Europe du Nord',
    'RU': 'Europe de l\'Est',
    'UA': 'Europe de l\'Est',
    'PL': 'Europe de l\'Est',
    'RO': 'Europe de l\'Est',
    'US': 'Amérique du Nord',
    'CA': 'Amérique du Nord',
    'MX': 'Amérique Centrale',
    'BR': 'Amérique du Sud',
    'AR': 'Amérique du Sud',
    'CL': 'Amérique du Sud',
    'CN': 'Asie de l\'Est',
    'JP': 'Asie de l\'Est',
    'KR': 'Asie de l\'Est',
    'IN': 'Asie du Sud',
    'PK': 'Asie du Sud',
    'BD': 'Asie du Sud',
    'TH': 'Asie du Sud-Est',
    'VN': 'Asie du Sud-Est',
    'ID': 'Asie du Sud-Est',
    'PH': 'Asie du Sud-Est',
    'SG': 'Asie du Sud-Est',
    'MY': 'Asie du Sud-Est',
    'AU': 'Océanie',
    'NZ': 'Océanie',
