# Configuration SPOFE Auto-Fix Script
# Copy to .env and fill in your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# MySQL Host
DB_HOST=localhost

# MySQL Port
DB_PORT=3306

# MySQL Username
DB_USER=root

# MySQL Password
DB_PASSWORD=

# MySQL Database Name
DB_NAME=spofe_v2_1

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment
NODE_ENV=development

# Project Root (auto-detected)
PROJECT_ROOT=

# Backend Directory
BACKEND_DIR=cascade

# Frontend Directory
FRONTEND_DIR=frontend

# ============================================================================
# SCRIPT CONFIGURATION
# ============================================================================

# Verbose logging (true/false)
VERBOSE=false

# Dry-run mode (true/false) - don't actually modify files
DRY_RUN=false

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Run package.json fixes
FIX_PACKAGE=true

# Run database validation
VALIDATE_DB=true

# Run test fixes
FIX_TESTS=true

# Generate reports
GENERATE_REPORTS=true

# Execute tests after fixes
RUN_TESTS=false

# ============================================================================
# LOGGING
# ============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log to file (true/false)
LOG_TO_FILE=false

# Log file path
LOG_FILE=auto-fix.log

# ============================================================================
# ADVANCED OPTIONS
# ============================================================================

# Maximum parallel operations
MAX_PARALLEL=4

# Timeout for long-running operations (ms)
TIMEOUT=30000

# Retry failed operations
RETRY_COUNT=3

# ============================================================================
# NOTES
# ============================================================================

# Pour XAMPP Local:
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=(vide)

# Pour serveur distant:
# DB_HOST=192.168.1.100
# DB_USER=admin
# DB_PASSWORD=mot_de_passe
