{
  "name": "spofe-app",
  "version": "2.1.0",
  "description": "SPOFE - Système de Pilotage Opérationnel et Financier Étendu - Application de comptabilité OHADA conforme WAEMU",
  "private": true,
  "license": "PROPRIETARY",
  "author": "Équipe SPOFE <tech@spofe.sn>",
  "homepage": "https://spofe.sn",
  "repository": {
    "type": "git",
    "url": "https://github.com/votre-organisation/spofe-app.git"
  },
  "keywords": [
    "comptabilité",
    "ohada",
    "waemu",
    "sénégal",
    "afrique",
    "gestion",
    "finance",
    "multi-entreprises"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },

  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd cascade && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "npm run dev",
    "start:prod": "cd cascade && npm run start",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd cascade && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "docker:build": "docker-compose -f docker-compose.prod.yml build",
    "docker:up": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "docker:restart": "npm run docker:down && npm run docker:build && npm run docker:up",
    
    // ========================
    // 🧪 TESTS
    // ========================
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "cd cascade && npm run test:unit",
    "test:integration": "cd cascade && npm run test:integration",
    "test:e2e": "playwright test --config=e2e/playwright.config.js",
    "test:coverage": "cd cascade && npm run test:coverage",
    
    // ========================
    // 🔍 DIAGNOSTIC & AUTO-FIX
    // ========================
    "diagnose": "npm run diagnose:login && npm run diagnose:db && npm run diagnose:security",
    "diagnose:login": "node scripts/login-flow-diagnostic.js --full",
    "diagnose:db": "node scripts/database-comprehensive-test.js",
    "diagnose:security": "node scripts/security-audit-check.js",
    "autofix": "node scripts/login-flow-autofix.js --apply",
    
    // ========================
    // 🗄️ BASE DE DONNÉES
    // ========================
    "db:setup": "cd cascade && npm run db:setup",
    "db:migrate": "cd cascade && npx sequelize-cli db:migrate",
    "db:migrate:undo": "cd cascade && npx sequelize-cli db:migrate:undo",
    "db:seed": "cd cascade && npx sequelize-cli db:seed:all",
    "db:seed:undo": "cd cascade && npx sequelize-cli db:seed:undo:all",
    "db:backup": "node scripts/database-backup.js",
    "db:restore": "node scripts/database-restore.js",
    "db:reset": "npm run db:migrate:undo && npm run db:migrate && npm run db:seed",
    
    // ========================
    // 📊 MONITORING & LOGS
    // ========================
    "monitor": "node scripts/integrated-monitoring-system.js",
    "monitor:logs": "tail -f logs/combined.log",
    "monitor:errors": "tail -f logs/error.log",
    "monitor:security": "tail -f logs/security.log",
    "logs:clean": "node scripts/logs-cleanup.js",
    
    // ========================
    // 🔒 SÉCURITÉ & AUDIT
    // ========================
    "audit": "npm audit --production",
    "audit:fix": "npm audit fix --production",
    "audit:full": "npm run audit:dependencies && npm run audit:security && npm run audit:code",
    "audit:dependencies": "npm audit --audit-level=high",
    "audit:security": "node scripts/security-audit-check.js --full",
    "audit:code": "npm run lint:security",
    
    // ========================
    // 📝 LINTING & FORMATTING
    // ========================
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd cascade && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:fix": "npm run lint:backend:fix && npm run lint:frontend:fix",
    "lint:security": "node scripts/security-code-scanner.js",
    "format": "npm run format:backend && npm run format:frontend",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    
    // ========================
    // 🚀 PRODUCTION
    // ========================
    "start": "cd cascade && npm start",
    "start:prod": "NODE_ENV=production pm2 start ecosystem.config.js",
    "stop:prod": "pm2 stop ecosystem.config.js",
    "restart:prod": "pm2 restart ecosystem.config.js",
    "status:prod": "pm2 status",
    "logs:prod": "pm2 logs",
    
    // ========================
    // 📦 MAINTENANCE
    // ========================
    "clean": "rm -rf node_modules && rm -rf cascade/node_modules && rm -rf frontend/node_modules",
    "reinstall": "npm run clean && npm install",
    "update": "npx npm-check-updates -u && npm install",
    "postinstall": "npm run setup",
    "setup": "node scripts/setup-environment.js",
    "health": "curl -f http://localhost:3001/api/health || echo 'Server not responding'",
    
    // ========================
    // 📊 RAPPORTS
    // ========================
    "report": "npm run report:coverage && npm run report:security && npm run report:performance",
    "report:coverage": "cd cascade && npm run test:coverage -- --coverageReporters=text-summary",
    "report:security": "node scripts/generate-security-report.js",
    "report:performance": "node scripts/performance-benchmark.js",
    
    // ========================
    // 🔄 CI/CD
    // ========================
    "ci:test": "npm run lint && npm run test && npm run build",
    "ci:deploy": "npm run docker:build && npm run docker:up",
    "predeploy": "npm run ci:test",
    "deploy": "npm run docker:restart"
  },

  "dependencies": {
    // ========================
    // 🏗️ FRAMEWORK CORE
    // ========================
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    
    // ========================
    // 🗄️ BASE DE DONNÉES
    // ========================
    "sequelize": "^6.35.0",
    "mysql2": "^3.6.0",
    "redis": "^4.6.0",
    
    // ========================
    // 🔐 AUTHENTIFICATION
    // ========================
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "otplib": "^12.0.1",
    
    // ========================
    // 📧 COMMUNICATION
    // ========================
    "nodemailer": "^6.9.7",
    "nodemailer-smtp-transport": "^2.7.4",
    "socket.io": "^4.7.0",
    
    // ========================
    // 📝 VALIDATION & PARSING
    // ========================
    "joi": "^17.11.0",
    "express-validator": "^7.0.1",
    "express-rate-limit": "^7.1.5",
    "express-slow-down": "^1.5.0",
    "multer": "^1.4.5-lts.1",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    
    // ========================
    // 📊 LOGGING & MONITORING
    // ========================
    "winston": "^3.11.0",
    "morgan": "^1.10.0",
    "prom-client": "^14.2.0",
    
    // ========================
    // 🛠️ UTILITAIRES
    // ========================
    "dotenv": "^16.3.1",
    "moment": "^2.29.4",
    "lodash": "^4.17.21",
    "axios": "^1.6.2",
    "uuid": "^9.0.1",
    "csv-parser": "^3.0.0",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.14.0",
    
    // ========================
    // 🔧 SÉCURITÉ AVANCÉE
    // ========================
    "csurf": "^1.11.0",
    "xss-clean": "^0.1.4",
    "hpp": "^0.2.3",
    "express-mongo-sanitize": "^2.2.0",
    "rate-limit-redis": "^3.0.1",
    
    // ========================
    // 🌐 INTERNATIONALISATION
    // ========================
    "i18n": "^0.15.1"
  },

  "devDependencies": {
    // ========================
    // 🧪 TESTING
    // ========================
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@playwright/test": "^1.40.0",
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "sinon": "^17.0.1",
    "nyc": "^15.1.0",
    
    // ========================
    // 📝 CODE QUALITY
    // ========================
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-node": "^11.1.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    
    // ========================
    // 🔄 DEVELOPMENT TOOLS
    // ========================
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    
    // ========================
    // 📦 BUILD TOOLS
    // ========================
    "webpack": "^5.89.0",
    "babel": "^6.23.0",
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    
    // ========================
    // 🔧 UTILITAIRES DEV
    // ========================
    "npm-check-updates": "^16.14.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "commitlint": "^18.4.3",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    
    // ========================
    // 📊 DOCUMENTATION
    // ========================
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    
    // ========================
    // 🐳 DOCKER
    // ========================
    "dockerfile-lint": "^0.4.0"
  },

  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },

  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },

  "commitlint": {
    "extends": ["@commitlint/config-conventional"]
  },

  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },

  "volta": {
    "node": "18.17.0",
    "npm": "9.6.7"
  },

  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}