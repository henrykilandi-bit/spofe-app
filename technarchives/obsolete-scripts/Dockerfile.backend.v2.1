# 🐳 SPOFE v2.1 Backend Dockerfile
# Production-ready multi-stage build with security hardening

FROM node:18-alpine AS builder

LABEL maintainer="SPOFE Team"
LABEL version="2.1.0"
LABEL description="SPOFE v2.1 Accounting Application - Backend"

WORKDIR /build

# Copy package files
COPY cascade/package*.json ./

# Install dependencies (production only)
RUN npm ci --only=production && \
    npm cache clean --force

# Verify security dependencies
RUN npm audit --production --audit-level=moderate || echo "Audit warnings present"

# ============================================
# PRODUCTION IMAGE
# ============================================

FROM node:18-alpine

# Install security tools
RUN apk add --no-cache \
    curl \
    dumb-init \
    tini

# Create app user (non-root)
RUN addgroup -g 1001 spofe && \
    adduser -D -u 1001 -G spofe spofe

WORKDIR /app

# Copy from builder
COPY --from=builder --chown=spofe:spofe /build/node_modules ./node_modules
COPY --chown=spofe:spofe cascade/src ./src
COPY --chown=spofe:spofe cascade/package*.json ./
COPY --chown=spofe:spofe cascade/.sequelizerc ./
COPY --chown=spofe:spofe cascade/ecosystem.config.js ./
COPY --chown=spofe:spofe cascade/jest.config.js ./

# Create necessary directories
RUN mkdir -p logs backups && \
    chown -R spofe:spofe /app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT:-3001}/api/health || exit 1

# Switch to non-root user
USER spofe

# Expose ports
EXPOSE 3001 9229

# Use dumb-init to properly handle signals
ENTRYPOINT ["/sbin/tini", "--"]

# Default command
CMD ["node", "src/server.js"]

# Environment variables (can be overridden)
ENV NODE_ENV=production \
    PORT=3001 \
    LOG_LEVEL=info \
    JWT_EXPIRES_IN=24h \
    JWT_REFRESH_EXPIRES_IN=7d \
    RATE_LIMIT_MAX=100 \
    RATE_LIMIT_WINDOW_MS=900000

# Labels for metadata
LABEL org.opencontainers.image.created="2026-01-21T00:00:00Z"
LABEL org.opencontainers.image.authors="SPOFE Development Team"
LABEL org.opencontainers.image.url="https://github.com/spofe/accounting-app"
LABEL org.opencontainers.image.documentation="https://docs.spofe.local"
LABEL org.opencontainers.image.source="https://github.com/spofe/accounting-app"
LABEL org.opencontainers.image.version="2.1.0"
LABEL org.opencontainers.image.title="SPOFE v2.1 Backend"
